#!/usr/bin/env php
<?php

declare(strict_types=1);

use voku\AgentMap\Cli\AgentMapApplication;

// The outer autoloader comes first on purpose. When this package is installed as a dependency its
// own vendor/ directory is normally absent, but a path repository, a mirrored checkout or a stale
// local install can leave one behind - and preferring it silently loads that copy's dependencies
// instead of the project's. The failure mode is a method or property that "does not exist" while the
// installed version plainly has it.
$autoload = __DIR__ . '/../../../autoload.php';
if (!is_file($autoload)) {
    $autoload = __DIR__ . '/../vendor/autoload.php';
}

if (function_exists('ini_set')) {
    $current = ini_get('memory_limit');
    if ($current !== false && $current !== '-1') {
        ini_set('memory_limit', '4G');
    }
}

require $autoload;

exit((new AgentMapApplication())->run($argv));
