--- /dev/null
+++ b/tests/AnalysisFingerprintTest.php
@@ -0,0 +1,52 @@
+<?php
+
+declare(strict_types=1);
+
+namespace voku\AgentMap\Tests;
+
+use Composer\InstalledVersions;
+use PHPUnit\Framework\TestCase;
+use voku\AgentMap\Index\AnalysisFingerprint;
+
+final class AnalysisFingerprintTest extends TestCase
+{
+    public function testNewPhpStanFingerprintRecordsInstalledPackageReference(): void
+    {
+        $fingerprint = new AnalysisFingerprint('2.2.0', 'sha256:config', 'sha256:lock', 'sha256:sources');
+
+        self::assertSame(InstalledVersions::getReference('phpstan/phpstan'), $fingerprint->phpStanPackageReference);
+        self::assertSame(InstalledVersions::getReference('phpstan/phpstan'), $fingerprint->toArray()['phpstan_package_reference']);
+    }
+
+    public function testStructuralFingerprintHasNoPackageReference(): void
+    {
+        $fingerprint = new AnalysisFingerprint('structural-only', 'sha256:none', 'sha256:lock', 'sha256:sources');
+
+        self::assertSame('none', $fingerprint->phpStanPackageReference);
+    }
+
+    public function testHistoricalFingerprintReportsUnknownPackageReference(): void
+    {
+        $fingerprint = AnalysisFingerprint::fromArray([
+            'phpstan_version' => '2.1.0',
+            'phpstan_config_sha256' => 'sha256:config',
+            'composer_lock_sha256' => 'sha256:lock',
+            'source_digest' => 'sha256:sources',
+        ]);
+
+        self::assertSame('unknown', $fingerprint->phpStanPackageReference);
+    }
+
+    public function testSerializedPackageReferenceRoundTripsUnchanged(): void
+    {
+        $serialized = [
+            'phpstan_version' => '2.1.0',
+            'phpstan_package_reference' => 'historical-exact-reference',
+            'phpstan_config_sha256' => 'sha256:config',
+            'composer_lock_sha256' => 'sha256:lock',
+            'source_digest' => 'sha256:sources',
+        ];
+
+        self::assertSame($serialized, AnalysisFingerprint::fromArray($serialized)->toArray());
+    }
+}
