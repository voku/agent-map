{
  "name": "voku/agent-map",
  "type": "library",
  "description": "Compact PHP repository symbol maps for coding-agent navigation.",
  "license": "MIT",
  "homepage": "https://github.com/voku/agent-map",
  "support": {
    "issues": "https://github.com/voku/agent-map/issues",
    "source": "https://github.com/voku/agent-map"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "php",
    "ast",
    "symbol-map",
    "code-index",
    "static-analysis",
    "phpstan",
    "ai",
    "llm"
  ],
  "authors": [
    {
      "name": "Lars Moelleken",
      "homepage": "https://github.com/voku"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/voku"
    }
  ],
  "bin": [
    "bin/agent-map"
  ],
  "autoload": {
    "psr-4": {
      "voku\\AgentMap\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "voku\\AgentMap\\Tests\\": "tests/",
      "voku\\AgentMap\\Dogfood\\": "tools/dogfood/"
    }
  },
  "require": {
    "php": ">=8.2",
    "composer-runtime-api": "^2.2",
    "helgesverre/toon": "^3.1",
    "voku/simple-php-code-parser": "^0.22",
    "voku/stop-words": "^2.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.0"
  },
  "suggest": {
    "phpstan/phpstan": "Enables PHPStan-backed semantic relation analysis; without it agent-map builds structural-only maps."
  },
  "scripts": {
    "post-install-cmd": "@php scripts/install-bin-proxy.php",
    "post-update-cmd": "@php scripts/install-bin-proxy.php",
    "test": "phpunit",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist",
    "ci": [
      "@composer validate --strict",
      "@test",
      "@phpstan"
    ]
  }
}
